// Power Query for the G2-D1 dashboard, generated by analysis/g2d1.py. See ../../g2-d1-dashboard.md section 5.
// Create a text parameter named BiFolder holding the folder path, with a backslash at the end.
// Then make one blank query per block: name it as written and paste the block into Advanced Editor.

// ===== fact_sales =====
let
    Source = Csv.Document(File.Contents(BiFolder & "fact_sales.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
    Typed = Table.TransformColumnTypes(Headers, {{"invoice", type text}, {"date_key", Int64.Type}, {"invoice_datetime", type datetime}, {"customer_key", Int64.Type}, {"product_key", type text}, {"country", type text}, {"quantity", Int64.Type}, {"unit_price_gbp", type number}, {"line_total_gbp", type number}}, "en-US")
in
    Typed

// ===== fact_returns =====
let
    Source = Csv.Document(File.Contents(BiFolder & "fact_returns.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
    Typed = Table.TransformColumnTypes(Headers, {{"invoice", type text}, {"date_key", Int64.Type}, {"customer_key", Int64.Type}, {"product_key", type text}, {"country", type text}, {"quantity", Int64.Type}, {"unit_price_gbp", type number}, {"line_total_gbp", type number}}, "en-US")
in
    Typed

// ===== fact_customer_month =====
let
    Source = Csv.Document(File.Contents(BiFolder & "fact_customer_month.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
    Typed = Table.TransformColumnTypes(Headers, {{"customer_key", Int64.Type}, {"year_month", type text}, {"month_end", type date}, {"date_key", Int64.Type}, {"first_order_month", type text}, {"last_order_month", type text}, {"days_since_last_order", Int64.Type}, {"orders_so_far", Int64.Type}, {"spend_last_12m_gbp", type number}, {"status", type text}, {"regular_6plus", type logical}, {"newly_silent", type logical}, {"active_2_points_ago", type logical}}, "en-US")
in
    Typed

// ===== dim_customer =====
let
    Source = Csv.Document(File.Contents(BiFolder & "dim_customer.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
    Typed = Table.TransformColumnTypes(Headers, {{"customer_key", Int64.Type}, {"country", type text}, {"segment", type text}, {"risk_band", type text}, {"status", type text}, {"first_purchase", type date}, {"last_purchase", type date}, {"frequency", Int64.Type}, {"monetary_gbp", type number}, {"recency_days", Int64.Type}, {"avg_days_between_orders", type number}, {"R_score", Int64.Type}, {"F_score", Int64.Type}, {"M_score", Int64.Type}, {"RFM_code", type text}, {"p_silent_180", type number}, {"worklist_flag", type logical}, {"worklist_rank", Int64.Type}, {"worklist_top50", type logical}, {"value_12m_gbp", type number}}, "en-US")
in
    Typed

// ===== dim_product =====
let
    Source = Csv.Document(File.Contents(BiFolder & "dim_product.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
    Typed = Table.TransformColumnTypes(Headers, {{"product_key", type text}, {"description", type text}, {"has_sales", type logical}}, "en-US")
in
    Typed

// ===== dim_date =====
let
    Source = Csv.Document(File.Contents(BiFolder & "dim_date.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
    Typed = Table.TransformColumnTypes(Headers, {{"date_key", Int64.Type}, {"date", type date}, {"year", Int64.Type}, {"quarter", type text}, {"year_quarter", type text}, {"month", Int64.Type}, {"year_month", type text}, {"month_name", type text}, {"iso_week", Int64.Type}, {"weekday", type text}}, "en-US")
