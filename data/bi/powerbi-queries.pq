    Typed = Table.TransformColumnTypes(Headers, {{"month_end", type date}, {"year_month", type text}, {"customers_seen", Int64.Type}, {"silent_180", Int64.Type}, {"silent_180_pct", type number}, {"silent_regulars_6plus", Int64.Type}, {"active_customers", Int64.Type}, {"revenue_last_12m_gbp", type number}}, "en-US")
in
    Typed

// ===== kpi_active_to_silent =====
let
    Source = Csv.Document(File.Contents(BiFolder & "kpi_active_to_silent.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
