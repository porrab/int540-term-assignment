table fact_customer_month
	lineageTag: fa52ab2c-127e-5430-aa82-546ae1d58956

	measure 'Silent % (as of month)' = ```
			DIVIDE(CALCULATE(COUNTROWS(fact_customer_month), fact_customer_month[status] = "Silent >180d"),
			COUNTROWS(fact_customer_month))
			```
		formatString: 0.00%
		lineageTag: 47c924d4-576e-5b7c-a736-1f61831f52e4

	measure 'Silent since 2 points ago' = ```
			CALCULATE(COUNTROWS(fact_customer_month), fact_customer_month[status] = "Silent >180d",
			fact_customer_month[active_2_points_ago] = TRUE())
			```
		formatString: #,0
		lineageTag: 01370c9b-2a08-5ce8-9a24-5127c0d2c4d4

	measure 'Silent value as of month' = CALCULATE(SUM(fact_customer_month[spend_last_12m_gbp]), fact_customer_month[status] = "Silent >180d")
		formatString: \£#,0.00;-\£#,0.00
		lineageTag: 605e6a6f-04ff-5c6f-b323-e9e63809e3cc

	measure 'Selected month' = SELECTEDVALUE(fact_customer_month[year_month])
		displayFolder: Page helpers (not in spec)
		lineageTag: fea24c11-e2b9-51f0-9413-db41fc654d31

