table dim_customer
	lineageTag: fd65a8cc-51f7-5961-a28e-cb4e1751363d

	measure 'Silent %' = ```
			DIVIDE(CALCULATE(COUNTROWS(dim_customer), KEEPFILTERS(dim_customer[status] = "Silent >180d")),
			CALCULATE(COUNTROWS(dim_customer), KEEPFILTERS(dim_customer[customer_key] <> 0)))
			```
		formatString: 0.00%
		lineageTag: 0716203a-3d0b-5063-9351-a653c11ce776

	measure 'Flagged customers' = CALCULATE(COUNTROWS(dim_customer), KEEPFILTERS(dim_customer[risk_band] = "High"))
		formatString: #,0
		lineageTag: 59545360-7b38-543a-b0d9-3b72e8e4c13a

	measure 'Top 50 value 12m' = CALCULATE(SUM(dim_customer[value_12m_gbp]), KEEPFILTERS(dim_customer[worklist_top50] = TRUE()))
		formatString: \£#,0.00;-\£#,0.00
		lineageTag: bfd4e27c-8a65-5e7b-b628-d244aab5aab7

	measure 'Customer share %' = DIVIDE([Customers], CALCULATE([Customers], ALL(dim_customer[segment])))
		formatString: 0.00%
		displayFolder: Page helpers (not in spec)
		lineageTag: 63b83738-1619-5bce-b823-93c05cf5dd3a

	measure 'Revenue share %' = DIVIDE([Revenue], CALCULATE([Revenue], ALL(dim_customer[segment])))
		formatString: 0.00%
		displayFolder: Page helpers (not in spec)
		lineageTag: edf885c4-6497-5a7d-ba53-b4a6b0a8a0bb

	measure 'Selected customer' = FORMAT(SELECTEDVALUE(dim_customer[customer_key]), "0")
		displayFolder: Page helpers (not in spec)
		lineageTag: 2f42ff8b-465e-5fd2-8acd-2de1f5008a74

	measure 'Rhythm note' = ```
			VAR f = SELECTEDVALUE(dim_customer[frequency])
			VAR a = SELECTEDVALUE(dim_customer[avg_days_between_orders])
			RETURN IF(f = 1, "One purchase", IF(f > 1 && a = 0, f & " orders on one day, no pattern yet", ""))
			```
		displayFolder: Page helpers (not in spec)
		lineageTag: 6f5aecac-b034-5dd4-bb31-995c0678f4c4

	measure 'Recency colour' = ```
			VAR r = SELECTEDVALUE(dim_customer[recency_days])
			VAR a = SELECTEDVALUE(dim_customer[avg_days_between_orders])
			RETURN IF(a > 0 && r > 3 * a, "#C00000", "#404040")
			```
		displayFolder: Page helpers (not in spec)
		lineageTag: e187d0b8-fc02-5040-8e4a-a3f5e2d7cf29

	measure 'Customer share colour' = IF(SELECTEDVALUE(dim_customer[segment]) = "Slipping regulars", "#F4B183", "#D0D0D0")
		displayFolder: Page helpers (not in spec)
		lineageTag: 573bb69f-ce8a-5e5a-bb0d-ef2559e87eb0

	measure 'Revenue share colour' = IF(SELECTEDVALUE(dim_customer[segment]) IN {"Loyal wholesale", "Slipping regulars"}, "#E66C37", "#8C8C8C")
		displayFolder: Page helpers (not in spec)
		lineageTag: 6c88b86b-ef44-50af-ab32-1fd99b20ca02

